# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Webhook & Server Settings
# BASE_URL must be the HTTPS domain of your Railway deployment (e.g. https://levelup-bot.up.railway.app)
BASE_URL=https://levelup-bot.up.railway.app
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=generate_a_secure_random_hex_string_here
PORT=8080
HOST=0.0.0.0

# Database
# In Railway, this is automatically provided by adding PostgreSQL plugin
DATABASE_URL=postgresql://postgres:password@localhost:5432/levelup

# Administration
# Comma-separated list of Telegram User IDs who have access to the admin panel
ADMIN_IDS=123456789,987654321

# Timezone for display
TIMEZONE=Asia/Tashkent

# Polling mode for local testing without webhook (True/False)
USE_POLLING=False
